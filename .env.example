# Copy to .env.local for local work. On Vercel, set each value per environment (Production / Preview / Development).
# Only NEXT_PUBLIC_* values reach the browser; every other value here is a server secret.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments: live (Production only) | test (Preview) | mock (local / DEMO_PUBLIC) ---
PAYMENTS_MODE=mock
# Set DEMO_PUBLIC=1 on Vercel for a marketing-only deploy (mock payments, no DATABASE_URL — env boot rejects DEMO+DB).
# DEMO_PUBLIC=
# Local/CI only: skip Turnstile when secret unset. Never set on Preview/Production.
# TURNSTILE_BYPASS=
# Cardcom sandbox: terminal 1000, API name test2025. Production: Yoav's terminal and API name.
CARDCOM_TERMINAL=
CARDCOM_API_NAME=

# --- Database (Neon Postgres). Without it the site shows the waitlist instead of checkout. ---
DATABASE_URL=

# --- Sanity: private dataset, read with a Viewer token (never Editor) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-01
SANITY_READ_TOKEN=
# openssl rand -base64 32 — the same value goes in the Sanity webhook "Secret" field
SANITY_REVALIDATE_SECRET=
# e.g. https://ridewithyoav.sanity.studio — allowed to frame the site for the Presentation tool
SANITY_STUDIO_ORIGIN=

# --- Signed links (thank-you, parent consent, feedback). openssl rand -base64 48 ---
TOKEN_SECRET=
# --- Vercel Cron bearer token (post-event feedback email). openssl rand -base64 48 ---
CRON_SECRET=

# --- Email (Resend; domain verified with SPF + DKIM) ---
RESEND_API_KEY=
MAIL_FROM=RideWithYoav <info@ridewithyoav.co.il>
NOTIFY_EMAIL=

# --- Google Sheets backup (service account, Editor on that one sheet only) ---
GOOGLE_SA_EMAIL=
# Paste the private_key from the JSON key with literal \n line breaks
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Abuse protection ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Monitoring ---
SENTRY_DSN=

# openssl rand -base64 32 — keeps Server Action IDs stable across Vercel instances
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Analytics (load only after cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
